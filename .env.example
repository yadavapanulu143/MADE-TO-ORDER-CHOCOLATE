# ---------------------------------------------------------------------------
# Copy to .env and fill in real values. NEVER commit .env.
# The defaults below are LOCAL DEVELOPMENT ONLY. Every value here must be
# replaced with a secret from a proper secret manager before any real deployment.
# ---------------------------------------------------------------------------

# ---- Infrastructure ----
POSTGRES_PORT=5432
POSTGRES_ROOT_PASSWORD=choco_root_pw
REDIS_PORT=6379
REDIS_PASSWORD=choco_redis_pw
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=choco
RABBITMQ_PASSWORD=choco_rabbit_pw

# ---- Per-service database credentials (one database and role per service) ----
IDENTITY_DB_URL=jdbc:postgresql://localhost:5432/choco_identity
IDENTITY_DB_USER=choco_identity
IDENTITY_DB_PASSWORD=choco_identity_pw

CATALOG_DB_URL=jdbc:postgresql://localhost:5432/choco_catalog
CATALOG_DB_USER=choco_catalog
CATALOG_DB_PASSWORD=choco_catalog_pw

ORDER_DB_URL=jdbc:postgresql://localhost:5432/choco_order
ORDER_DB_USER=choco_order
ORDER_DB_PASSWORD=choco_order_pw

PAYMENT_DB_URL=jdbc:postgresql://localhost:5432/choco_payment
PAYMENT_DB_USER=choco_payment
PAYMENT_DB_PASSWORD=choco_payment_pw

FULFILMENT_DB_URL=jdbc:postgresql://localhost:5432/choco_fulfilment
FULFILMENT_DB_USER=choco_fulfilment
FULFILMENT_DB_PASSWORD=choco_fulfilment_pw

NOTIFICATION_DB_URL=jdbc:postgresql://localhost:5432/choco_notification
NOTIFICATION_DB_USER=choco_notification
NOTIFICATION_DB_PASSWORD=choco_notification_pw

REPORTING_DB_URL=jdbc:postgresql://localhost:5432/choco_reporting
REPORTING_DB_USER=choco_reporting
REPORTING_DB_PASSWORD=choco_reporting_pw

# ---- JWT signing (identity-service is the only holder of the private key) ----
# Generate a 2048-bit RSA key pair. The private key stays with identity-service only;
# every other service verifies tokens through the public JWKS endpoint.
JWT_ISSUER=choco-identity
JWT_PRIVATE_KEY_PATH=/run/secrets/jwt-private.pem
JWT_PUBLIC_KEY_PATH=/run/secrets/jwt-public.pem
JWT_ACCESS_TOKEN_TTL_SECONDS=900
JWT_REFRESH_TOKEN_TTL_DAYS=30
JWT_JWK_SET_URI=http://localhost:8081/.well-known/jwks.json

# ---- Password hashing ----
# argon2id (recommended) or bcrypt (cost factor 15)
PASSWORD_HASH_ALGORITHM=argon2id

# ---- Razorpay (TEST MODE keys while developing) ----
# From https://dashboard.razorpay.com -> Settings -> API Keys.
# Test keys start with rzp_test_. Never commit live keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_CURRENCY=INR

# ---- Email (SMTP) ----
# Development default is Mailpit, which captures mail instead of sending it.
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@chocolate.local
MAIL_TLS=false

# ---- SMS ----
# provider: LOG (development), MSG91 or TWILIO
SMS_PROVIDER=LOG
SMS_API_KEY=
SMS_SENDER_ID=
SMS_TEMPLATE_OTP=

# ---- Object storage for product images and invoice PDFs ----
STORAGE_TYPE=LOCAL
STORAGE_LOCAL_PATH=./data/uploads
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ---- Frontend origins allowed by CORS ----
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# ---- Observability ----
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_TRACES_SAMPLING_PROBABILITY=1.0
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_USER=admin
GRAFANA_PASSWORD=choco_grafana_pw
LOKI_PORT=3100
TEMPO_PORT=3200

# ---- Business settings ----
# Seller contact details shown on the storefront and used in notifications.
SELLER_NAME=
SELLER_EMAIL=
SELLER_PHONE=
