# ---------------------------------------------------------------------------
# Copy to .env and fill in real values. NEVER commit .env.
#
# These are the variables docker-compose.yml, docker-compose.app.yml and
# docker-compose.prod.yml interpolate. A name that is not read by one of those
# files has no effect, so this list is kept in step with them deliberately.
#
# The defaults below are LOCAL DEVELOPMENT ONLY. Every value here must be
# replaced with a secret from a proper secret manager before any real deployment.
# In the production shape (docker-compose.prod.yml) most of these become
# mandatory: the stack refuses to start with an empty one rather than falling
# back to a development default.
# ---------------------------------------------------------------------------

# ---- Published host ports (the gateway and the two frontends only) ----
GATEWAY_PORT=8080
STOREFRONT_PORT=5173
ADMIN_PORT=5174

# ---- Infrastructure ----
POSTGRES_PORT=5432
POSTGRES_ROOT_PASSWORD=choco_root_pw
REDIS_PORT=6379
REDIS_PASSWORD=choco_redis_pw
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=choco
RABBITMQ_PASSWORD=choco_rabbit_pw
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# ---- Per-service database passwords (one role per service) ----
IDENTITY_DB_PASSWORD=choco_identity_pw
CATALOG_DB_PASSWORD=choco_catalog_pw
ORDER_DB_PASSWORD=choco_order_pw
PAYMENT_DB_PASSWORD=choco_payment_pw
FULFILMENT_DB_PASSWORD=choco_fulfilment_pw
NOTIFICATION_DB_PASSWORD=choco_notification_pw
REPORTING_DB_PASSWORD=choco_reporting_pw

# ---- Password hashing ----
# argon2id (recommended) or bcrypt (cost factor 15)
PASSWORD_HASH_ALGORITHM=argon2id

# ---- Razorpay (TEST MODE keys while developing) ----
# From https://dashboard.razorpay.com -> Settings -> API Keys.
# Test keys start with rzp_test_. Never commit live keys. With RAZORPAY_ENABLED
# false (the default) the payment service still boots but refuses every
# money-moving call — it never pretends a payment succeeded.
RAZORPAY_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- Email (SMTP) ----
# Development default is the Mailpit sink, which captures mail instead of
# sending it. In the production shape SMTP_USER/SMTP_PASSWORD/SMTP_AUTH/SMTP_TLS
# point at the real provider.
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM=no-reply@chocolate.local
SMTP_USER=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_TLS=true

# ---- SMS ----
# No provider is selected by default; codes are not sent. Set the gateway URL and
# API key to enable SMS, or leave blank to keep the log-only behaviour.
CHOCO_SMS_GATEWAY_URL=
CHOCO_SMS_API_KEY=

# ---- Verification code (OTP) logging ----
# Writes verification codes to the application log so a developer can complete
# registration without a mail server. Leave this false everywhere a real
# customer can register: a logged OTP is usable by anyone who can read the log.
# The production shape forces it to false.
CHOCO_LOG_OTP=false

# ---- Admin bootstrap ----
# Creates the FIRST administrator once, on identity-service startup, then must be
# cleared. There is deliberately no public admin sign-up: an administrator can
# only be provisioned here. Leave both blank and nothing is created. The password
# must satisfy the shared password policy or startup fails; a weak password is
# never seeded. Change the password through the application and clear these
# values afterwards.
CHOCO_ADMIN_BOOTSTRAP_EMAIL=
CHOCO_ADMIN_BOOTSTRAP_PASSWORD=
CHOCO_ADMIN_BOOTSTRAP_NAME=Administrator

# ---- Seller contact details ----
# Shown on the storefront and used as the reply-to/sender on notifications.
CHOCO_SELLER_EMAIL=
CHOCO_SELLER_MOBILE=

# ---- Business limits ----
CHOCO_FULFILMENT_MAX_UNITS=0
CHOCO_FULFILMENT_PROOF_REQUIRED=false
CHOCO_NOTIFICATION_MAX_ATTEMPTS=3

# ---- Frontend origins allowed by CORS ----
# Comma-separated. The production shape requires this so CORS is never wildcarded.
CHOCO_CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# ---- Observability ----
CHOCO_LOG_LEVEL=INFO
CHOCO_OTLP_ENABLED=false
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_USER=admin
GRAFANA_PASSWORD=choco_grafana_pw
LOKI_PORT=3100
TEMPO_PORT=3200
