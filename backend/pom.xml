  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-enforcer-plugin</artifactId>
          <version>${maven-enforcer-plugin.version}</version>
          <executions>
            <execution>
              <id>enforce-clean-architecture</id>
              <goals>
                <goal>enforce</goal>
              </goals>
              <phase>validate</phase>
              <configuration>
                <rules>
                  <bannedDependencies>
                    <searchTransitive>true</searchTransitive>
                    <excludes>
                      <!-- Modules that opt in via skipEnforcer=false must not pull in these. -->
                      <exclude>org.springframework.boot:*</exclude>
                      <exclude>org.springframework:*</exclude>
                      <exclude>org.hibernate.orm:*</exclude>
                      <exclude>jakarta.persistence:*</exclude>
                      <exclude>jakarta.servlet:*</exclude>
                      <exclude>com.razorpay:*</exclude>
                      <exclude>com.fasterxml.jackson.core:*</exclude>
                      <exclude>org.flywaydb:*</exclude>
                      <exclude>org.postgresql:*</exclude>
                    </excludes>
                    <message>
                      Clean Architecture violation: the domain layer must not depend on framework or
                      provider libraries. Business rules belong in plain Java.
                    </message>
                  </bannedDependencies>
                </rules>
                <fail>true</fail>
                <skip>${skipEnforcer}</skip>
              </configuration>
            </execution>
          </executions>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <configuration>
            <argLine>-XX:+EnableDynamicAgentLoading -Xshare:off</argLine>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-failsafe-plugin</artifactId>
          <configuration>
            <argLine>-XX:+EnableDynamicAgentLoading -Xshare:off</argLine>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <!-- Applied to every module; individual modules opt out with -DskipEnforcer=true. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
      </plugin>
      <!--
        Binds failsafe to the integration-test and verify phases, so tests named *IT run during
        `mvn verify`. Declaring the plugin without an execution leaves the goals unbound, and the
        tests are then never run: they compile, they appear in the source tree, and nothing reports
        that they were skipped. Binding it here means every module's integration tests actually run.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <repositories>
    <repository>
      <id>central</id>
      <url>https://repo.maven.apache.org/maven2</url>
      <snapshots>
        <enabled>false</enabled>
      </snapshots>
    </repository>
  </repositories>
</project>
